# ==============================================================================
# TelegramMediChat Configuration
# ==============================================================================

# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Admin Telegram IDs (Comma-separated for multiple admins)
# You can find your Telegram ID using @userinfobot or @raw_data_bot
ADMIN_IDS=123456789,987654321

# Default AI Provider & Model Configuration (Can also be modified in-bot via /admin)
AI_PROVIDER_NAME=OpenRouter
AI_MODEL_NAME=openrouter/free
AI_API_URL=https://openrouter.ai/api/v1/chat/completions
AI_API_KEY=sk-or-v1-your-openrouter-api-key-here

# Enable Advanced Reasoning (Sends {"reasoning": {"enabled": true}} payload for DeepSeek R1 / OpenRouter)
AI_ENABLE_REASONING=true

# Maximum Requests Quota (0 = Unlimited, e.g. 50 = stops after 50 total queries until reset)
CHATBOT_MAX_REQUESTS=50

# Database Storage Path
DB_PATH=medichat.db
